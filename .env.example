# Copy to .env and adjust. .env is git-ignored; never commit real credentials.

# Application
APP_ENV=development
APP_PORT=8080
GIN_MODE=debug

# Database (DB_HOST=127.0.0.1 for `make run`; docker compose overrides it to the mysql service)
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=billing_user
DB_PASSWORD=billing_password
DB_NAME=billing_db
MYSQL_ROOT_PASSWORD=rootpassword

# Connection pool (optional)
DB_MAX_OPEN_CONNS=25
DB_MAX_IDLE_CONNS=5
DB_CONN_MAX_LIFETIME=5m

# HTTP server timeouts (optional, Go duration format)
SERVER_READ_TIMEOUT=10s
SERVER_WRITE_TIMEOUT=30s
SERVER_IDLE_TIMEOUT=60s
SERVER_SHUTDOWN_TIMEOUT=15s
