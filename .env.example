# Copy to .env and adjust. .env is git-ignored; never commit real credentials.

# Application
APP_ENV=development
APP_PORT=8080
GIN_MODE=debug

# Google sign-in (OAuth 2.0 authorization code flow). In Google Cloud Console create an
# OAuth 2.0 "Web application" client (APIs & Services > Credentials) and add these
# Authorized redirect URIs (exact match):
#   http://localhost:5173/api/v1/auth/google/callback   (vite dev server)
#   http://localhost:3000/api/v1/auth/google/callback   (docker compose)
#   https://<your-domain>/api/v1/auth/google/callback   (production)
# The client secret stays on the API server and is never sent to the browser.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Must equal one of the redirect URIs registered above, for the environment you are running.
GOOGLE_REDIRECT_URL=http://localhost:5173/api/v1/auth/google/callback
# Random string, at least 32 characters; signs the session and OAuth state cookies. Generate with: openssl rand -base64 48
SESSION_SECRET=
# Optional: session lifetime (Go duration) and whether cookies are HTTPS-only (defaults to true in production).
SESSION_TTL=12h
# AUTH_COOKIE_SECURE=false
# Escape hatch for local work without a Google client: leaves every /api/v1 route open.
AUTH_DISABLED=false
#
# Who may sign in is NOT configured here: it is the authorized_users table.
# Add yourself once the database is up:  make authorize EMAIL=you@gmail.com

# Database (DB_HOST=127.0.0.1 for `make run`; docker compose overrides it to the mysql service)
DB_HOST=127.0.0.1
DB_PORT=3306
# Choose your own credentials; docker compose refuses to start without them.
# MySQL creates DB_USER/DB_PASSWORD on first boot of an empty data volume.
DB_USER=
DB_PASSWORD=
DB_NAME=billing_db
MYSQL_ROOT_PASSWORD=

# Connection pool (optional)
DB_MAX_OPEN_CONNS=25
DB_MAX_IDLE_CONNS=5
DB_CONN_MAX_LIFETIME=5m

# HTTP server timeouts (optional, Go duration format)
SERVER_READ_TIMEOUT=10s
SERVER_WRITE_TIMEOUT=30s
SERVER_IDLE_TIMEOUT=60s
SERVER_SHUTDOWN_TIMEOUT=15s
